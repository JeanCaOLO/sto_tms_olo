exports[`LiquidarViajeModal (caracterización) > vista extendida 1`] = `"<div><div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"><div role="dialog" aria-modal="true" aria-labelledby="_r_ID_" tabindex="-1" class="flex w-full max-w-7xl max-h-[90vh] flex-col overflow-y-auto rounded-lg bg-white shadow-xl outline-none"><h2 id="_r_ID_" class="sr-only">Liquidar viaje</h2><div class="shrink-0 bg-white flex items-center justify-between px-6 py-4 border-b border-slate-200"><div><h2 class="text-lg font-semibold text-slate-800">Liquidar viaje<span class="ml-2 text-sm font-normal text-slate-500">V-CAR-CCS</span></h2><p class="text-xs text-slate-500 mt-0.5">Revise los datos del viaje. El total se calcula solo.</p></div><div class="flex gap-1 bg-slate-100 rounded-lg p-1 w-fit" role="group" aria-label="Tipo de vista"><button type="button" class="px-3 py-1 text-xs font-medium rounded-md transition-colors cursor-pointer text-slate-600 hover:text-slate-900">Vista simple</button><button type="button" class="px-3 py-1 text-xs font-medium rounded-md transition-colors cursor-pointer bg-white text-teal-700 shadow-sm">Vista extendida</button></div><button class="text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Cerrar"><i class="ri-close-line text-xl"></i></button></div><div class="flex-1 min-h-0 overflow-y-auto px-6 py-5"><div class="grid grid-cols-1 lg:grid-cols-5 gap-6"><div class="lg:col-span-3"><div class="space-y-5"><section><h3 class="text-sm font-semibold text-slate-700 mb-3">1 · El viaje</h3><div class="bg-slate-50 border border-slate-200 rounded-lg px-4 py-3"><div class="grid grid-cols-2 md:grid-cols-4 gap-y-2 gap-x-4 text-xs"><div><div class="text-[11px] text-slate-400">Viaje</div><div class="text-slate-800 font-medium">V-CAR-CCS</div></div><div><div class="text-[11px] text-slate-400">Fecha</div><div class="text-slate-800 font-medium">2026-09-01</div></div><div><div class="text-[11px] text-slate-400">Transportista</div><div class="text-s