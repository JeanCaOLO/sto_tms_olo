-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="OWN">Propia</option><option value="OUTSOURCED">Tercerizada</option></select></div><div class="border-t border-slate-200 pt-3"><p class="text-[11px] text-slate-500 uppercase font-medium mb-2">Lo del día</p><div class="grid grid-cols-2 md:grid-cols-3 gap-3"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Fecha</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " type="date" value="2026-09-01"></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Servicio</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="STANDARD">Estándar</option><option value="EXPRESS">Express</option><option value="DEDICATED">Dedicado</option></select></div></div></div><p class="text-[11px] text-slate-400">Peajes, recolectas, atrasos e incidencias se prueban como variables propias de la compañía: se declaran en su ficha y aparecen acá como campos.</p><p class="text-xs text-slate-400">Acá no se emite nada: es el mismo cálculo que hará la liquidación, con los mismos datos. La bifurcación nómina (flota propia) / cuentas por pagar (tercero) la deciden las reglas condicionadas por flota, no un cálculo aparte.</p></div></div><div class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 "><h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2"><i class="ri-file-list-3-line text-teal-600"></i>¿Por qué este total?</h3><div class="mb-4 rounded-lg px-4 py-3 border text-sm bg-red-50 border-red-200 text-red-800"><i class="ri-error-warning-line mr-1"></i>El total se movió: esperaba <strong>$718.67</strong> y da <strong>$775.40</strong> (diferencia 56.73). Si el cambio es correcto, fijá el total nuevo.<div class="mt-2"><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-3 py-1.5 text-sm "><i class="ri-bookmark-line mr-1"></i>Fijar $775.40 como el total esperado</button></div></div><div class="space-y-4"><div class="flex gap-1 bg-slate-100 rounded-lg p-1 w-fit"><button type="button" class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors cursor-pointer text-slate-600 hover:text-slate-900">Resumen</button><button type="button" class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors cursor-pointer bg-white text-teal-700 shadow-sm">Detalle</button><button type="button" class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors cursor-pointer text-slate-600 hover:text-slate-900">Auditoría</button></div><div class="border border-slate-200 rounded-lg overflow-hidden"><table class="w-full text-sm"><tbody class="divide-y divide-slate-100"><tr><td class="px-4 py-2 text-slate-600">Base</td><td class="px-4 py-2 text-right font-medium text-slate-800">$665.40</td></tr><tr><td class="px-4 py-2 text-slate-600">Variable</td><td class="px-4 py-2 text-right font-medium text-slate-800">$80.00</td></tr><tr><td class="px-4 py-2 text-slate-600">Modificador</td><td class="px-4 py-2 text-right font-medium text-slate-800">$30.00</td></tr></tbody><tfoot class="bg-slate-50 border-t-2 border-teal-200"><tr><td class="px-4 py-2.5 font-semibold text-slate-900">Total a liquidar</td><td class="px-4 py-2.5 text-right"><span class="text-lg font-bold text-teal-700">$775.40</span></td></tr></tfoot></table></div><div class="overflow-x-auto border 