exports[`RuleModal (caracterización) > alta: pestaña avanzada (JSON) 1`] = `"<div><div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"><div role="dialog" aria-modal="true" aria-labelledby="_r_ID_" tabindex="-1" class="flex w-full max-w-3xl max-h-[90vh] flex-col overflow-y-auto rounded-lg bg-white shadow-xl outline-none"><h2 id="_r_ID_" class="sr-only">Nueva regla</h2><div class="sticky top-0 bg-white flex items-center justify-between px-6 py-4 border-b border-gray-200 z-10"><div></div><div class="flex gap-1 bg-gray-100 rounded-lg p-1"><button type="button" class="px-3 py-1 text-xs rounded-md transition-colors text-gray-600">Simple</button><button type="button" class="px-3 py-1 text-xs rounded-md transition-colors bg-white text-teal-700 shadow-sm">Avanzado (JSON)</button></div></div><form class="p-6 space-y-6"><section><h3 class="text-sm font-semibold text-gray-700 mb-3">Identificación</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Código *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="BONO-PEAJES" required="" value=""></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="Bono por peaje transitado" required="" value=""></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Alcance *</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="COUNTRY">Todas las compañías del país</option><option value="PARTY">Solo una compañía</option></select></div></div></section><section class="border-t border-gray-200 pt-4"><div class="flex items-center justify-between mb-3"><h3 class="text-sm font-semibold text-gray-700">¿Cuándo aplica?</h3><div class="flex gap-1 bg-gray-100 rounded-lg p-1"><button type="button" class="px-3 py-1 text-xs rounded-md transition-colors bg-white text-teal-700 shadow-sm">Siempre</button><button type="button" class="px-3 py-1 text-xs rounded-md transition-colors text-gray-600">Si se cumple…</button><button type="button" class="px-3 py-1 text-xs rounded-md transition-colors text-gray-600">JSON</button></div></div></section><section class="border-t border-gray-200 pt-4"><h3 class="text-sm font-semibold text-gray-700 mb-2">Expresión (JSON del motor)</h3><textarea rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs font-mono focus:outline-none focus:ring-2 focus:ring-teal-500">{ "op": "FIXED", "amount": "0" }</textarea><p class="text-xs text-gray-500 mt-1">Para escalones, mínimos/máximos, condicionales y tarifas por zona — lo que el formulario simple no cubre. Se valida al guardar.</p></section><section class="border-t border-gray-200 pt-4 space-y-3"><div><div class="flex items-center justify-between mb-1.5"><label for="rule-description" class="block text-sm font-medium text-slate-700">Descripción</label></div><textarea id="rule-description" rows="2" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500">Por cada unidad de paradas completadas se suma 0 VES.</textarea><p class="text-xs text-gray-500 mt-1">Se escribe sola desde el cálculo. Editala si querés otra redacción.</p></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Motivo</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="Acuerdo con el transportista de agosto 2026" value=""></div></div></section><section class="border-t border-gray-200 pt-4"><h3 class="text-sm font-semibold text-gray-700 mb-1">Desde y hasta cuándo rige</h3><p class="text-xs text-gray-500 mb-3">Se compara contra la <strong>fecha del viaje</strong>, no contra hoy. Un viaje de agosto se sigue liquidando con la tarifa de agosto aunque el acuerdo ya haya cambiado. Dejalas vacías si la regla no tiene vencimiento.</p><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Rige desde</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " type="date" value=""></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Rige hasta</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " type="date" value=""></div></div></div><p class="text-xs text-gray-500 mt-2">Ambos días quedan <strong>incluidos</strong>. Vencerla no es lo mismo que desactivarla: una regla vencida sigue aplicando a los viajes anteriores a su fecha de fin, y una inactiva no aplica a ninguno.</p></section><section class="border-t border-gray-200 pt-4"><h3 class="text-sm font-semibold text-gray-700 mb-3">Cómo convive con las demás reglas</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Etapa del cálculo *</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="BASE">Base (precio base de la ruta)</option><option value="VARIABLE">Variable (cliente / kg / bulto)</option><option value="MODIFIER">Modificador (ajuste por servicio)</option><option value="SURCHARGE">Recargo (pernocta, peajes y otros variables propios)</option><option value="ADJUSTMENT">Ajuste (descuentos/penalidades)</option><option value="TAX">Impuesto</option></select></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">¿Se suma o compite? *</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="SUM">Se suma a las demás</option><option value="MAX">Compite: gana la de monto más alto del grupo</option><option value="EXCLUSIVE">Compite: gana la de mayor prioridad</option></select></div><label class="flex items-center gap-2 text-sm text-slate-700 pb-2 cursor-pointer"><input class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" type="checkbox" checked="">Regla activa</label></div></section><div class="flex justify-end gap-3 pt-2 border-t border-gray-200 px-6 pb-6"><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-4 py-2 text-sm " type="button">Cancelar</button><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-teal-600 hover:bg-teal-700 text-white shadow-sm hover:shadow-md px-4 py-2 text-sm " type="submit">Crear regla</button></div></form></div></div></div>"`;

