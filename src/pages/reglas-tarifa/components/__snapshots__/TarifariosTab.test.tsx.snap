exports[`TarifariosTab (caracterización) > lista los tarifarios del país y avisa que se puede tocar uno 1`] = `"<div class="space-y-6"><div class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 "><div class="flex items-center justify-between mb-4"><div class="flex items-center gap-2"><h3 class="text-sm font-semibold text-slate-700">Tarifarios</h3><div class="relative inline-block"><button type="button" aria-label="Ayuda" class="flex h-5 w-5 items-center justify-center rounded-full border text-xs font-semibold transition-colors border-slate-300 text-slate-500 hover:bg-slate-50">?</button></div></div><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-teal-600 hover:bg-teal-700 text-white shadow-sm hover:shadow-md px-4 py-2 text-sm "><i class="ri-add-line mr-1"></i>Nuevo tarifario</button></div><div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden"><div class="flex flex-wrap items-center justify-between gap-3 p-4 border-b border-slate-100 bg-white/70 backdrop-blur-sm"><div class="relative flex-1 min-w-[220px] max-w-sm"><div class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center text-slate-400"><i class="ri-search-line text-sm"></i></div><input placeholder="Buscar tarifario..." class="w-full pl-10 pr-4 py-2 text-sm bg-white/80 backdrop-blur border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all" value=""></div><div class="flex items-center gap-3"><span class="text-xs text-slate-400 whitespace-nowrap">1 registro</span><div class="relative"><button type="button" aria-expanded="false" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium bg-slate-50 text-slate-700 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer whitespace-nowrap"><i class="ri-layout-column-line"></i>Columnas</button></div><button class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"><i class="ri-file-excel-2-line"></i>Exportar Excel</button></div></div><div class="overflow-auto" style="max-height: 19rem;"><table class="w-full text-sm"><thead><tr class="border-b border-slate-200 bg-slate-50"><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" class="inline-flex items-center gap-1 cursor-pointer hover:text-teal-600">Código<span class="flex flex-col leading-none text-[10px] -space-y-0.5"><i class="ri-arrow-up-s-fill text-slate-300"></i><i class="ri-arrow-down-s-fill text-slate-300"></i></span></button></div></th><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" class="inline-flex items-center gap-1 cursor-pointer hover:text-teal-600">Nombre<span class="flex flex-col leading-none text-[10px] -space-y-0.5"><i class="ri-arrow-up-s-fill text-slate-300"></i><i class="ri-arrow-down-s-fill text-slate-300"></i></span></button></div></th><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" disabled="" class="inline-flex items-center gap-1 cursor-default">Valores</button></div></th><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" disabled="" class="inline-flex items-center gap-1 cursor-default">Clave</button></div></th><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" class="inline-flex items-center gap-1 cursor-pointer hover:text-teal-600">Alcance<span class="flex flex-col leading-none text-[10px] -space-y-0.5"><i class="ri-arrow-up-s-fill text-slate-300"></i><i class="ri-arrow-down-s-fill text-slate-300"></i></span></button><button type="button" data-filter-trigger="true" class="cursor-pointer text-slate-400 hover:text-slate-600"><i class="ri-filter-3-fill text-xs"></i></button></div></th><th draggable="true" class="relative sticky top-0 z-10 bg-slate-50 px-4 py-3 font-semibold text-slate-700 whitespace-nowrap text-left "><div class="inline-flex items-center gap-1"><button type="button" class="inline-flex items-center gap-1 cursor-pointer hover:text-teal-600">Estado<span class="flex flex-col leading-none text-[10px] -space-y-0.5"><i class="ri-arrow-up-s-fill text-slate-300"></i><i class="ri-arrow-down-s-fill text-slate-300"></i></span></button><button type="button" data-filter-trigger="true" class="cursor-pointer text-slate-400 hover:text-slate-600"><i class="ri-filter-3-fill text-xs"></i></button></div></th><th class="px-4 py-3 font-semibold text-slate-700 text-right whitespace-nowrap sticky top-0 z-10 bg-slate-50">Acciones</th></tr></thead><tbody><tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors cursor-pointer "><td class="px-4 py-3 text-slate-700 text-left "><span class="font-mono text-teal-700">ZONAS</span></td><td class="px-4 py-3 text-slate-700 text-left ">Tarifas por zona</td><td class="px-4 py-3 text-slate-700 text-left "><span class="text-xs text-slate-600">Uno por fila</span></td><td class="px-4 py-3 text-slate-700 text-left "><span class="text-xs text-slate-600">Zona de origen · Zona de destino</span></td><td class="px-4 py-3 text-slate-700 text-left "><span class="inline-flex items-center whitespace-nowrap font-medium rounded-full bg-slate-100 text-slate-700 px-2.5 py-1 text-sm ">Todo el país</span></td><td class="px-4 py-3 text-slate-700 text-left "><span class="inline-flex items-center whitespace-nowrap font-medium rounded-full bg-emerald-100 text-emerald-700 px-2.5 py-1 text-sm ">Activo</span></td><td class="px-4 py-3 text-right"><div class="flex items-center justify-end gap-2"><button class="w-8 h-8 flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" title="Editar"><i class="ri-edit-line"></i></button><button class="w-8 h-8 flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" title="Desactivar"><i class="ri-forbid-line"></i></button><button class="w-8 h-8 flex items-center justify-center text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" title="Eliminar"><i class="ri-delete-bin-line"></i></button></div></td></tr></tbody></table></div></div><p class="text-xs text-slate-500 mt-3"><i class="ri-cursor-line mr-1"></i>Tocá un tarifario para ver y cargar sus filas.</p></div></div>"`;
