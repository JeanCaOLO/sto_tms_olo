exports[`RateTableModal (caracterización) > edición: cargar el tarifario y avisar si se cambia la clave 1`] = `"<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"><div class="bg-white rounded-lg shadow-xl w-full max-w-3xl max-h-[90vh] overflow-y-auto"><div class="sticky top-0 bg-white flex items-center justify-between px-6 py-4 border-b border-slate-200 z-10"><div><h2 class="text-lg font-semibold text-slate-800">Editar ZONAS</h2><p class="text-xs text-slate-500 mt-0.5">Una fila por combinación, en vez de una regla por combinación.</p></div><button class="text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Cerrar"><i class="ri-close-line text-xl"></i></button></div><div class="px-6 py-5 space-y-5"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Código *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="TARIFARIO_ZONAS" value="ZONAS"></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="Tarifario por zona y camión" value="Tarifas por zona"></div></div></div><p class="text-xs text-slate-500 -mt-3">El <strong>código</strong> es con el que una regla nombra este tarifario. Sin espacios ni acentos.</p><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Alcance</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="">Todo el país</option><option value="SP_VE_OWN">Flota Propia Venezuela</option><option value="CARRIER_VE_2">Logística del Centro</option><option value="CARRIER_VE_1">Transporte Andino</option></select></div><p class="text-xs text-slate-500 -mt-3">Un tarifario de compañía con el <strong>mismo código</strong> que uno del país lo reemplaza para esa compañía — igual que con las reglas.</p><div class="flex items-start gap-2 bg-slate-50 border border-slate-200 text-slate-600 text-xs rounded-lg px-3 py-2.5 -mt-1"><i class="ri-money-dollar-circle-line mt-0.5 shrink-0"></i><span>Los importes van en <strong>VES</strong>, que es la única moneda del país. No hay conversión: lo que se carga acá es lo que se paga.</span></div><div class="border border-slate-200 rounded-lg p-4 space-y-3"><div><h3 class="text-sm font-semibold text-slate-700">Clave del tarifario</h3><p class="text-xs text-slate-500 mt-0.5">Qué mira el motor para elegir la fila. El orden es el orden de las columnas al cargar las filas.</p></div><ol class="space-y-1.5"><li class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2"><span class="w-5 h-5 shrink-0 flex items-center justify-center bg-teal-100 text-teal-700 rounded text-xs font-medium">1</span><span class="flex-1 text-sm text-slate-800">Zona de origen</span><code class="text-[11px] text-slate-400 font-mono">originZone</code><button type="button" disabled="" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded cursor-pointer disabled:opacity-25 disabled:cursor-not-allowed" title="Subir"><i class="ri-arrow-up-line"></i></button><button type="button" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded cursor-pointer disabled:opacity-25 disabled:cursor-not-allowed" title="Bajar"><i class="ri-arrow-down-line"></i></button><button type="button" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-red-600 hover:bg-red-50 rounded cursor-pointer" title="Quitar"><i class="ri-close-line"></i></button></li><li class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2"><span class="w-5 h-5 shrink-0 flex items-center justify-center bg-teal-100 text-teal-700 rounded text-xs font-medium">2</span><span class="flex-1 text-sm text-slate-800">Zona de destino</span><code class="text-[11px] text-slate-400 font-mono">destZone</code><button type="button" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded cursor-pointer disabled:opacity-25 disabled:cursor-not-allowed" title="Subir"><i class="ri-arrow-up-line"></i></button><button type="button" disabled="" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded cursor-pointer disabled:opacity-25 disabled:cursor-not-allowed" title="Bajar"><i class="ri-arrow-down-line"></i></button><button type="button" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-red-600 hover:bg-red-50 rounded cursor-pointer" title="Quitar"><i class="ri-close-line"></i></button></li></ol><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Agregar variable a la clave</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option value="">Elegir…</option><option value="originZoneGroup">Grupo de zona de origen</option><option value="destZoneGroup">Grupo de zona de destino</option><option value="truckTypeId">Tipo de camión</option><option value="serviceType">Tipo de servicio</option><option value="fleetType">Flota</option><option value="carrierId">Transportista</option><option value="customerId">Cliente</option><option value="countryId">País</option><option value="weekday">Día de la semana</option><option value="km">Distancia (km)</option><option value="weightKg">Peso (kg)</option><option value="clientCount">Paradas completadas</option><option value="durationHours">Duración (h)</option><option value="truckWeightTons">Capacidad del camión (t)</option><option value="truckVolumeM3">Volumen del camión (m³)</option></select></div><div class="bg-slate-800 rounded-lg px-3 py-2.5 overflow-x-auto"><p class="text-[11px] text-slate-400 mb-1">Así se va a ver una fila:</p><code class="text-xs text-teal-300 font-mono whitespace-nowrap">Zona de origen  |  Zona de destino  |  Importe</code></div><div class="flex items-start gap-2 bg-slate-50 border border-slate-200 text-slate-600 text-xs rounded-lg px-3 py-2.5"><i class="ri-information-line mt-0.5 shrink-0"></i><span>Las variables <strong>categóricas</strong> (zona, tipo de camión…) casan con un valor exacto. Las <strong>numéricas</strong> (kilómetros, peso, paradas, horas) casan por <strong>rango</strong>: en la fila se escribe el tramo, por ejemplo <code class="font-mono">0..100</code>, <code class="font-mono">101..300</code> o <code class="font-mono">301..</code> (extremos incluidos), y 181 km cae en «101..300». Una celda vacía vale para todo. Las variables personalizadas solo se pueden usar en el tarifario de una compañía con perfil de cálculo.</span></div></div><div class="border border-slate-200 rounded-lg p-4 space-y-2"><h3 class="text-sm font-semibold text-slate-700">Columnas de valor adicionales (opcional)</h3><p class="text-xs text-slate-500">Por defecto cada fila trae un solo importe. Si la misma combinación da más de un valor (por ejemplo <em>flete</em> y <em>peaje</em>), escribí sus nombres separados por coma y cada regla elegirá cuál usa.</p><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Nombres de las columnas</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="flete, peaje" value=""></div></div></div><label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer"><input class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" type="checkbox" checked="">Tarifario activo</label></div><div class="sticky bottom-0 bg-white flex justify-end gap-2 px-6 py-4 border-t border-slate-200"><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-4 py-2 text-sm ">Cancelar</button><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-teal-600 hover:bg-teal-700 text-white shadow-sm hover:shadow-md px-4 py-2 text-sm "><i class="ri-save-line mr-1"></i>Guardar cambios</button></div></div></div>"`;

exports[`RateTableModal (caracterización) > la clave se puede quitar, agregar y reordenar 1`] = `"<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"><div class="bg-white rounded-lg shadow-xl w-full max-w-3xl max-h-[90vh] overflow-y-auto"><div class="sticky top-0 bg-white flex items-center justify-between px-6 py-4 border-b border-slate-200 z-10"><div><h2 class="text-lg font-semibold text-slate-800">Nuevo tarifario</h2><p class="text-xs text-slate-500 mt-0.5">Una fila por combinación, en vez de una regla por combinación.</p></div><button class="text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Cerrar"><i class="ri-close-line text-xl"></i></button></div><div class="px-6 py-5 space-y-5"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Código *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="TARIFARIO_ZONAS" value=""></div></div><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre *</label><div class="relative"><input id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " placeholder="Tarifario por zona y camión" value=""></div></div></div><p class="text-xs text-slate-500 -mt-3">El <strong>código</strong> es con el que una regla nombra este tarifario. Sin espacios ni acentos.</p><div class="w-full"><label for="_r_ID_" class="block text-sm font-medium text-slate-700 mb-1.5">Alcance</label><select id="_r_ID_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all cursor-pointer  "><option va