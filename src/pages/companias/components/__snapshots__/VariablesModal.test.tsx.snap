ounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-teal-600 hover:bg-teal-700 text-white shadow-sm hover:shadow-md px-4 py-2 text-sm " type="button"><i class="ri-save-line mr-1"></i>Agregar variable</button></div></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-slate-200 text-left text-xs font-medium text-slate-500 uppercase"><th class="px-3 py-2">Clave</th><th class="px-3 py-2">Nombre</th><th class="px-3 py-2">Tipo</th><th class="px-3 py-2">Origen</th><th class="px-3 py-2">Valor</th><th class="px-3 py-2">Estado</th><th class="px-3 py-2 text-right">Acciones</th></tr></thead><tbody class="divide-y divide-slate-100"><tr class=""><td class="px-3 py-2 font-mono text-xs text-slate-600">custom:horas_carga</td><td class="px-3 py-2 text-slate-800">Horas de carga</td><td class="px-3 py-2 text-slate-600">Número</td><td class="px-3 py-2 text-slate-600">Constante</td><td class="px-3 py-2 text-slate-600">15<span class="text-xs text-slate-400"> horas</span></td><td class="px-3 py-2"><span class="inline-flex items-center whitespace-nowrap font-medium rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 text-xs ">Activa</span></td><td class="px-3 py-2"><div class="flex items-center justify-end gap-1"><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-100 text-slate-700 px-3 py-1.5 text-sm " title="Editar"><i class="ri-edit-line"></i></button><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-100 text-slate-700 px-3 py-1.5 text-sm " title="Dar de baja"><i class="ri-forbid-line"></i></button></div></td></tr><tr class=""><td class="px-3 py-2 font-mono text-xs text-slate-6