exports[`CostStructureModal: estructura heredada > copiarla crea una estructura propia con los mismos conceptos 1`] = `"<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"><div class="bg-white rounded-lg shadow-xl w-full max-w-5xl max-h-[92vh] overflow-y-auto"><div class="sticky top-0 bg-white flex items-center justify-between px-6 py-4 border-b border-slate-200 z-10"><div><h2 class="text-lg font-semibold text-slate-800">Estructura de costos — Transportes Uno</h2><p class="text-xs text-slate-500 mt-0.5">Los gastos de operar un viaje de esta flota propia. Se acumulan y es lo que se liquida y se envía a cuentas por pagar.</p></div><button class="text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Cerrar"><i class="ri-close-line text-xl"></i></button></div><div class="px-6 py-5 space-y-5"><div class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end"><div class="w-full"><label for="_r_7_" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre</label><div class="relative"><input id="_r_7_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " value="Costos de flota propia — por defecto (VE) (propia)"></div></div><div class="w-full"><label for="_r_8_" class="block text-sm font-medium text-slate-700 mb-1.5">Días operativos por mes</label><div class="relative"><input id="_r_8_" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all   " type="number" value="30"></div></div><button class="whitespace-nowrap inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-4 py-2 text-sm "><i class="ri-save-line mr-1"></i> Guardar parámetros</button></div><