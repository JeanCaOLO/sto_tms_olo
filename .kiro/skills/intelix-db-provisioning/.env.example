# ============================================================
# CONFIGURACION VIA VARIABLES DE ENTORNO (alternativa a config.yaml)
# Pensado para pipelines CI/CD. Copia este archivo a ".env" o
# exporta estas variables en tu runner (GitHub Actions, GitLab CI,
# Jenkins, Azure DevOps, etc.).
#
#   cp .env.example .env
#   python generate.py --engine all --env-file .env
#   python validate.py --engine all --env-file .env
#
# En CI/CD lo habitual es NO usar archivo y exportar las variables
# como secretos del pipeline, luego:
#   python generate.py --engine all --from-env
#
# Prioridad: las variables del entorno del proceso sobreescriben
# las definidas en el archivo .env.
# ============================================================

# --- Identificacion ---
DBKIT_COMPANIA=acme
DBKIT_AMBIENTE=prd
DBKIT_APLICATIVO=ventas

# --- Esquemas: uno o varios separados por coma (un solo run) ---
DBKIT_SCHEMAS=core,staging,audit

# --- Contrasenas (usar SECRETOS del pipeline, no hardcodear en repo) ---
DBKIT_PASS_RO=Ro_Ventas!2024Ax
DBKIT_PASS_RW=Rw_Ventas!2024Bx
DBKIT_PASS_DDL=Ddl_Ventas!2024Cx
DBKIT_PASS_ADMIN=Adm_Ventas!2024Dx
DBKIT_PASS_OWNER=Own_Ventas!2024Zx

# --- PostgreSQL ---
DBKIT_PG_ENCODING=UTF8
DBKIT_PG_COLLATE=es_ES.UTF-8
DBKIT_PG_CTYPE=es_ES.UTF-8

# --- MySQL / MariaDB ---
DBKIT_MY_CHARSET=utf8mb4
DBKIT_MY_COLLATION=utf8mb4_unicode_ci

# --- Oracle ---
DBKIT_ORA_DEFAULT_TS=USERS
DBKIT_ORA_TEMP_TS=TEMP
