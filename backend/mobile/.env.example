# Copia este archivo a .env (no se sube al repo). Solo desarrollo local; en AWS todo sale de Secrets Manager.

# BD compartida con el TMS (Aurora tms_olo). Con el túnel SSM abierto: host=localhost, port=15432.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=tms_olo
DB_USER=
DB_PASSWORD=
# Dueño de las tablas, solo para migraciones (DDL). Sin estas cae al usuario de arriba.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Secreto PROPIO de los tokens de la app (distinto al del TMS). Genera uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Bucket de evidencias: el MISMO que lee la web del TMS (el que crea el stack tracking). Opcional en local.
EVIDENCE_BUCKET=
AWS_REGION=us-east-2

# Nombre del rol de los choferes en la tabla roles.
DRIVER_ROLE_NAME=Chofer
API_PORT=4100
