# EFLOW - SQL Server (read-only). Copiar a .env.local y llenar con valores reales.
# El server (`pnpm server`) enruta por país: /api/...?pais=cr|ve.
# Credenciales SOLO aquí (en .env.local, gitignored) — NUNCA en .env ni commiteadas.

# Costa Rica: EFLOW_WMH (torre de control) + EFLOW_OLO (WMS/expediciones).
EFLOW_CR_HOST=
EFLOW_CR_PORT=1433
EFLOW_CR_USER=
EFLOW_CR_PASSWORD=
EFLOW_CR_DB_WMH=EFLOW_WMH
EFLOW_CR_DB_SAP=EFLOW_OLO

# Venezuela: WMH + una BD de compañía (EFLOW_FEBECA por defecto; también EFLOW_BEVAL / EFLOW_SILLACA).
EFLOW_VE_HOST=
EFLOW_VE_PORT=1446
EFLOW_VE_USER=
EFLOW_VE_PASSWORD=
EFLOW_VE_DB_WMH=WMH
EFLOW_VE_DB_SAP=EFLOW_FEBECA

# Compat: si solo defines EFLOW_QA_* se usan como Costa Rica (pais=cr).
EFLOW_QA_HOST=
EFLOW_QA_PORT=1433
EFLOW_QA_USER=
EFLOW_QA_PASSWORD=
EFLOW_QA_DB_WMH=EFLOW_WMH
EFLOW_QA_DB_SAP=EFLOW_OLO_QA_SAP

# true = saltar login, entrar como superusuario mock (sin BD ni EFLOW).
VITE_MOCK_AUTH=

# GitLab Intelix (git.intelix.biz) - Project Access Token para scripts/pull-gitlab.ps1
# rol Developer, scope write_repository. NUNCA lo pongas aqui ni en .env: va en
# .env.local (gitignored) o directo en $env:GITLAB_TOKEN de tu shell.
GITLAB_TOKEN=

# Base del API desplegado (API Gateway del TMS-Backend). Vacío en dev: Vite
# proxya /api/* -> localhost:4000 (pnpm server). En el build de un ambiente se
# setea a la URL del stage, p.ej.:
#   https://<id>.execute-api.us-east-1.amazonaws.com/<env>
# Sin barra final. Solo se usa en build (import.meta.env.VITE_API_BASE).
VITE_API_BASE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_DIR=

# ─── Variables del FRONTEND (Vite) ──────────────────────────────────────────────────────────────────
# Solo se leen al construir (`pnpm build`) o al levantar `pnpm dev`. Las de producción se definen en el
# entorno del build (Amplify o `deploy-frontend.ps1`), no en el código. Todas son opcionales en desarrollo.

# API del tarifador (Liquidaciones, Reglas, Proformas). Por defecto usa VITE_API_BASE + /api.
# Define solo si el tarifador vive en otra URL. Sin barra final.
VITE_TARIFAS_API_URL=

# WebSocket de avisos en vivo (pedidos nuevos para Planificación). En AWS es el API Gateway WebSocket
# (wss://...). ATENCION: si no se define, el código usa ws://localhost:4100 (el servidor de demo
# `ws-local.mjs`), que en producción apunta a la máquina de cada usuario: no conecta y la alerta de
# pedidos nuevos queda solo con el polling de respaldo. En producción hay que definirla.
VITE_WS_URL=

# Motor de rutas por calles (OSRM) para dibujar los recorridos de Tracking y Planificación.
# ATENCION: si no se define, el código usa https://router.project-osrm.org, un servidor DEMO público sin SLA
# (puede caerse o limitar peticiones) que además recibe las coordenadas de los camiones y las paradas. En
# producción conviene un OSRM propio (ver infra/osrm/).
VITE_OSRM_URL=

# Tiles del mapa de Tracking. ATENCION: si no se define, el código usa los tiles públicos de OpenStreetMap
# (https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png), cuya política de uso no admite carga de producción.
# En producción usa un proveedor con SLA. La atribución del mapa sigue diciendo OpenStreetMap.
VITE_MAP_TILES_URL=

# Login con Google (Google Identity Services). ID del cliente OAuth 'TMS login', proyecto sistema-tms-513814.
# Es publico (va en el navegador). Vacio = no se muestra el boton. El secreto del cliente NO va aqui.
VITE_GOOGLE_CLIENT_ID=
