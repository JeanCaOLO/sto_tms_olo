<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:flujo="http://flujo.app/schema/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Category_verificacion">
    <bpmn:categoryValue id="CategoryValue_verificacion" value="Verificación" />
  </bpmn:category>
  <bpmn:category id="Category_ajustes">
    <bpmn:categoryValue id="CategoryValue_ajustes" value="Ajustes" />
  </bpmn:category>
  <bpmn:category id="Category_liquidacion">
    <bpmn:categoryValue id="CategoryValue_liquidacion" value="Liquidación" />
  </bpmn:category>
  <bpmn:category id="Category_registro">
    <bpmn:categoryValue id="CategoryValue_registro" value="Registro" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="PROCESO DE LIQUIDACIÓN" processRef="Process_1" />
    <bpmn:textAnnotation id="TextAnnotation_estados">
      <bpmn:text>Estados: En Progreso (facturas sin trade), Finalizados (trade realizado), Liquidados, Planificado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_origen">
      <bpmn:text>Datos provenientes de la asignación de viajes (Torre de Control) y del monitoreo de trade.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_peculiaridades">
      <bpmn:text>Trade puede reflejar finalización total aunque existan devoluciones parciales u otras peculiaridades.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_sello">
      <bpmn:text>La factura debe contar con el sello del departamento de devoluciones.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_razon">
      <bpmn:text>La razón de devolución es obligatoria (campo predeterminado o descripción manual).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_porcentaje">
      <bpmn:text>Cada casa paga un porcentaje del viaje según el valor de la mercancía transportada.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_camion">
      <bpmn:text>Casos como anulación desde ventas, camión sin salida, etc.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_recolectas">
      <bpmn:text>Las recolectas se pagan manualmente; el liquidador no las refleja automáticamente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_desglose">
      <bpmn:text>El desglose de facturas muestra el estado de cada una (asignado por Torre de Control).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_tresfacturas">
      <bpmn:text>Se generan tres facturas, una por cada casa comercial.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:Association id="Association_peculiaridades" sourceRef="Activity_revisarFisico" targetRef="TextAnnotation_peculiaridades" flujo:manualRoute="true" />
    <bpmn:Association id="Association_sello" sourceRef="Activity_devolucionParcial" targetRef="TextAnnotation_sello" flujo:manualRoute="true" />
    <bpmn:Association id="Association_razon" sourceRef="Activity_devolucionTotal" targetRef="TextAnnotation_razon" flujo:manualRoute="true" />
    <bpmn:Association id="Association_porcentaje" sourceRef="Activity_liquidar" targetRef="TextAnnotation_porcentaje" flujo:manualRoute="true" />
    <bpmn:Association id="Association_camion" sourceRef="Activity_marcarInformativa" targetRef="TextAnnotation_camion" flujo:manualRoute="true" />
    <bpmn:Association id="Association_recolectas" sourceRef="Activity_agregarRecolectas" targetRef="TextAnnotation_recolectas" />
    <bpmn:Association id="Association_desglose" sourceRef="Activity_verificarEstado" targetRef="TextAnnotation_desglose" />
    <bpmn:Association id="Association_tresfacturas" sourceRef="Activity_recibirFacturas" targetRef="TextAnnotation_tresfacturas" flujo:manualRoute="true" />
    <bpmn:textAnnotation id="TextAnnotation_1809qkh">
      <bpmn:text>Se tiene planteado cambiar esto para calcular por volumen y peso tambien</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1" />
    <bpmn:startEvent id="StartEvent_1" name="Facturas físicas recibidas">
      <bpmn:outgoing>Flow_inicio_filtrar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_seleccionar" name="Seleccionar viaje">
      <bpmn:incoming>Flow_filtrar_seleccionar</bpmn:incoming>
      <bpmn:outgoing>Flow_seleccionar_finalizado</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_finalizado" name="¿Viaje finalizado?">
      <bpmn:incoming>Flow_seleccionar_finalizado</bpmn:incoming>
      <bpmn:outgoing>Flow_si_finalizado</bpmn:outgoing>
      <bpmn:outgoing>Flow_no_finalizado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_verificarEstado" name="Verificar estado de facturas">
      <bpmn:incoming>Flow_no_finalizado</bpmn:incoming>
      <bpmn:outgoing>Flow_verificar_comparar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_comparar" name="Comparar información">
      <bpmn:incoming>Flow_verificar_comparar</bpmn:incoming>
      <bpmn:outgoing>Flow_comparar_orden</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_orden" name="¿Información en orden?">
      <bpmn:incoming>Flow_comparar_orden</bpmn:incoming>
      <bpmn:outgoing>Flow_orden_si</bpmn:outgoing>
      <bpmn:outgoing>Flow_orden_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_realizarTrade" name="Realizar trade">
      <bpmn:incoming>Flow_orden_si</bpmn:incoming>
      <bpmn:outgoing>Flow_trade_revisar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_noLiquidar" name="No se puede liquidar">
      <bpmn:incoming>Flow_orden_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_revisarFisico" name="Revisar factura física">
      <bpmn:incoming>Flow_si_finalizado</bpmn:incoming>
      <bpmn:incoming>Flow_trade_revisar</bpmn:incoming>
      <bpmn:outgoing>Flow_revisar_peculiaridad</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_peculiaridad" name="¿Hay peculiaridad?">
      <bpmn:incoming>Flow_revisar_peculiaridad</bpmn:incoming>
      <bpmn:outgoing>Flow_peculiaridad_si</bpmn:outgoing>
      <bpmn:outgoing>Flow_peculiaridad_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_liquidar" name="Liquidar viaje">
      <bpmn:incoming>Flow_peculiaridad_no</bpmn:incoming>
      <bpmn:incoming>Flow_sustraer_liquidar</bpmn:incoming>
      <bpmn:incoming>Flow_0pbl1xh</bpmn:incoming>
      <bpmn:outgoing>Flow_liquidar_proforma</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_afectaPago" name="¿Afecta pago?">
      <bpmn:incoming>Flow_peculiaridad_si</bpmn:incoming>
      <bpmn:outgoing>Flow_afecta_si</bpmn:outgoing>
      <bpmn:outgoing>Flow_afecta_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_marcarInformativa" name="Marcar como informativa">
      <bpmn:incoming>Flow_afecta_no</bpmn:incoming>
      <bpmn:outgoing>Flow_informativa_liquidar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_tipoAjuste" name="¿Tipo de ajuste?">
      <bpmn:incoming>Flow_afecta_si</bpmn:incoming>
      <bpmn:outgoing>Flow_tipo_devolucionTotal</bpmn:outgoing>
      <bpmn:outgoing>Flow_tipo_devolucionParcial</bpmn:outgoing>
      <bpmn:outgoing>Flow_tipo_recolecta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_devolucionTotal" name="Marcar devolución total">
      <bpmn:incoming>Flow_tipo_devolucionTotal</bpmn:incoming>
      <bpmn:outgoing>Flow_devolucionTotal_sustraer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_abrirDesglose" name="Abrir desglose de productos">
      <bpmn:incoming>Flow_tipo_devolucionParcial</bpmn:incoming>
      <bpmn:outgoing>Flow_desglose_revisar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_devolucionParcial" name="Revisar devolución parcial">
      <bpmn:incoming>Flow_desglose_revisar</bpmn:incoming>
      <bpmn:outgoing>Flow_devolucionParcial_sustraer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_sustraer" name="Sustraer montos devueltos">
      <bpmn:incoming>Flow_devolucionTotal_sustraer</bpmn:incoming>
      <bpmn:incoming>Flow_devolucionParcial_sustraer</bpmn:incoming>
      <bpmn:outgoing>Flow_sustraer_liquidar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_agregarRecolectas" name="Agregar recolectas">
      <bpmn:incoming>Flow_tipo_recolecta</bpmn:incoming>
      <bpmn:outgoing>Flow_0pbl1xh</bpmn:outgoing>
    </bpmn:task>
    <bpmn:SequenceFlow id="Flow_informativa_liquidar" sourceRef="Activity_marcarInformativa" targetRef="Activity_liquidar" />
    <bpmn:SequenceFlow id="Flow_sustraer_liquidar" sourceRef="Activity_sustraer" targetRef="Activity_liquidar" flujo:manualRoute="true" />
    <bpmn:task id="Activity_generarProforma" name="Generar proforma">
      <bpmn:incoming>Flow_liquidar_proforma</bpmn:incoming>
      <bpmn:outgoing>Flow_proforma_enviar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_enviarProforma" name="Enviar proforma">
      <bpmn:incoming>Flow_proforma_enviar</bpmn:incoming>
      <bpmn:outgoing>Flow_enviar_recibir</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_recibirFacturas" name="Recibir facturas y proformas">
      <bpmn:incoming>Flow_enviar_recibir</bpmn:incoming>
      <bpmn:outgoing>Flow_recibir_registrar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_registrar" name="Registrar facturas en Google Sheets">
      <bpmn:incoming>Flow_recibir_registrar</bpmn:incoming>
      <bpmn:outgoing>Flow_registrar_fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_fin" name="Fin del proceso">
      <bpmn:incoming>Flow_registrar_fin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:SequenceFlow id="Flow_inicio_filtrar" sourceRef="StartEvent_1" targetRef="Activity_filtrar" />
    <bpmn:SequenceFlow id="Flow_filtrar_seleccionar" sourceRef="Activity_filtrar" targetRef="Activity_seleccionar" />
    <bpmn:SequenceFlow id="Flow_seleccionar_finalizado" sourceRef="Activity_seleccionar" targetRef="Gateway_finalizado" />
    <bpmn:SequenceFlow id="Flow_si_finalizado" name="Sí" sourceRef="Gateway_finalizado" targetRef="Activity_revisarFisico" />
    <bpmn:SequenceFlow id="Flow_no_finalizado" name="No" sourceRef="Gateway_finalizado" targetRef="Activity_verificarEstado" />
    <bpmn:SequenceFlow id="Flow_verificar_comparar" sourceRef="Activity_verificarEstado" targetRef="Activity_comparar" />
    <bpmn:SequenceFlow id="Flow_comparar_orden" sourceRef="Activity_comparar" targetRef="Gateway_orden" />
    <bpmn:SequenceFlow id="Flow_orden_si" name="Sí" sourceRef="Gateway_orden" targetRef="Activity_realizarTrade" />
    <bpmn:SequenceFlow id="Flow_orden_no" name="No" sourceRef="Gateway_orden" targetRef="Event_noLiquidar" />
    <bpmn:SequenceFlow id="Flow_trade_revisar" sourceRef="Activity_realizarTrade" targetRef="Activity_revisarFisico" flujo:manualRoute="true" />
    <bpmn:SequenceFlow id="Flow_revisar_peculiaridad" sourceRef="Activity_revisarFisico" targetRef="Gateway_peculiaridad" />
    <bpmn:SequenceFlow id="Flow_peculiaridad_si" name="Sí" sourceRef="Gateway_peculiaridad" targetRef="Gateway_afectaPago" />
    <bpmn:SequenceFlow id="Flow_peculiaridad_no" name="No" sourceRef="Gateway_peculiaridad" targetRef="Activity_liquidar" />
    <bpmn:SequenceFlow id="Flow_afecta_si" name="Sí" sourceRef="Gateway_afectaPago" targetRef="Gateway_tipoAjuste" />
    <bpmn:SequenceFlow id="Flow_afecta_no" name="No" sourceRef="Gateway_afectaPago" targetRef="Activity_marcarInformativa" />
    <bpmn:SequenceFlow id="Flow_tipo_devolucionTotal" name="Devolución total" sourceRef="Gateway_tipoAjuste" targetRef="Activity_devolucionTotal" />
    <bpmn:SequenceFlow id="Flow_tipo_devolucionParcial" name="Devolución parcial" sourceRef="Gateway_tipoAjuste" targetRef="Activity_abrirDesglose" />
    <bpmn:SequenceFlow id="Flow_tipo_recolecta" name="Recolecta" sourceRef="Gateway_tipoAjuste" targetRef="Activity_agregarRecolectas" flujo:manualRoute="true" />
    <bpmn:SequenceFlow id="Flow_devolucionTotal_sustraer" sourceRef="Activity_devolucionTotal" targetRef="Activity_sustraer" />
    <bpmn:SequenceFlow id="Flow_desglose_revisar" sourceRef="Activity_abrirDesglose" targetRef="Activity_devolucionParcial" />
    <bpmn:SequenceFlow id="Flow_devolucionParcial_sustraer" sourceRef="Activity_devolucionParcial" targetRef="Activity_sustraer" />
    <bpmn:SequenceFlow id="Flow_liquidar_proforma" sourceRef="Activity_liquidar" targetRef="Activity_generarProforma" flujo:manualRoute="true" />
    <bpmn:SequenceFlow id="Flow_proforma_enviar" sourceRef="Activity_generarProforma" targetRef="Activity_enviarProforma" />
    <bpmn:SequenceFlow id="Flow_enviar_recibir" sourceRef="Activity_enviarProforma" targetRef="Activity_recibirFacturas" />
    <bpmn:SequenceFlow id="Flow_recibir_registrar" sourceRef="Activity_recibirFacturas" targetRef="Activity_registrar" />
    <bpmn:SequenceFlow id="Flow_registrar_fin" sourceRef="Activity_registrar" targetRef="Event_fin" />
    <bpmn:task id="Activity_filtrar" name="Filtrar viajes">
      <bpmn:incoming>Flow_inicio_filtrar</bpmn:incoming>
      <bpmn:outgoing>Flow_filtrar_seleccionar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:SequenceFlow id="Flow_0pbl1xh" sourceRef="Activity_agregarRecolectas" targetRef="Activity_liquidar" />
    <bpmn:Group id="Group_verificacion" categoryValueRef="CategoryValue_verificacion" />
    <bpmn:Group id="Group_ajustes" categoryValueRef="CategoryValue_ajustes" />
    <bpmn:Group id="Group_liquidacion" categoryValueRef="CategoryValue_liquidacion" />
    <bpmn:Group id="Group_registro" categoryValueRef="CategoryValue_registro" />
    <bpmn:Association id="Association_estados" sourceRef="Activity_filtrar" targetRef="TextAnnotation_estados" flujo:manualRoute="true" />
    <bpmn:Association id="Association_origen" sourceRef="Activity_filtrar" targetRef="TextAnnotation_origen" flujo:manualRoute="true" />
  </bpmn:process>
